[Unit]
Description=soar-agent - Agente SOAR (eBPF) con panel web
Documentation=https://github.com/REEMPLAZA_USUARIO/soar-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/soar-agent --config /etc/soar-agent/agent.yaml
Restart=on-failure
RestartSec=2
User=root
# Endurecimiento: sistema de solo lectura salvo lo imprescindible.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/soar-agent /var/log/soar-agent
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
